# フォロー関係の保存先を DynamoDB にするときに、backend/.env へ書き足す行。
# (.env は Git 管理外。提出時点の .env.example には手を入れないため、雛形をここに分けている)
#
# アクセスキーはここに書かない。`aws configure` で PC 側に設定し、AWS SDK に読ませる。

# json(既定) か dynamodb
FOLLOW_STORE=dynamodb
# infra/follow-table.yaml の TableName と同じ値
FOLLOW_TABLE_NAME=follow-relations-dev
# テーブルを作ったリージョン
AWS_REGION=ap-northeast-1
